<Window x:Class="EFP_forensic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:EFP_forensic.Helpers"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Biometric Intake Client"
        Height="860"
        MinHeight="740"
        Width="1320"
        MinWidth="1120"
        Background="#F3F5F7"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17202A" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#101828" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DEE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#145DA0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B8C2CC" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#344054" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#B42318" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="BorderBrush" Value="#B9C2CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#E8F1FB" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,24,22,18">
                    <TextBlock Text="Biometric" Foreground="White" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Intake Client" Foreground="#B8C2CC" FontSize="18" />
                </StackPanel>
                <StackPanel Margin="14,18">
                    <TextBlock Text="Ticket Verification" Foreground="#FFFFFF" FontSize="14" Margin="8,10" />
                    <TextBlock Text="Applicant Review" Foreground="#D0D5DD" FontSize="14" Margin="8,10" />
                    <TextBlock Text="Fingerprint Capture" Foreground="#D0D5DD" FontSize="14" Margin="8,10" />
                    <TextBlock Text="Quality Review" Foreground="#D0D5DD" FontSize="14" Margin="8,10" />
                    <TextBlock Text="Submission" Foreground="#D0D5DD" FontSize="14" Margin="8,10" />
                    <Border Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="Current Step" Foreground="#98A2B3" FontSize="12" />
                            <TextBlock Text="{Binding CurrentStepName}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#D9DEE7" BorderThickness="0,0,0,1" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Biometric Intake Client" Foreground="#101828" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StationStatus}" Foreground="#067647" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Foreground="#344054" FontSize="14" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OfficerId, StringFormat=Officer: {0}}" Foreground="#667085" FontSize="13" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28">
                    <Grid Visibility="{Binding IsTicketVerificationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource Card}" MaxWidth="780" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Ticket Verification" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Tracking Number" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding TicketVerification.TrackingNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         CharacterCasing="Upper"
                                         Margin="0,6,0,16" />
                                <Button Content="Verify Ticket"
                                        Command="{Binding TicketVerification.VerifyCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="170"
                                        HorizontalAlignment="Left" />
                                <Border Margin="0,18,0,0" Padding="14" CornerRadius="8" Background="#FEF3F2"
                                        Visibility="{Binding TicketVerification.HasMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding TicketVerification.Message}" Foreground="#7A271A" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsApplicantReviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Applicant Review" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,22,0">
                                        <TextBlock Text="Full Name" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding ApplicantReview.Applicant.FullName}" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="Date of Birth" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding ApplicantReview.Applicant.DateOfBirth, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="National ID" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding ApplicantReview.Applicant.NationalId}" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="Passport Number" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding ApplicantReview.Applicant.PassportNumber}" Style="{StaticResource ValueText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Payment Status" Style="{StaticResource LabelText}" />
                                        <Border Style="{StaticResource Badge}" Background="#DCFAE6" Margin="0,5,0,12">
                                            <TextBlock Text="{Binding ApplicantReview.Applicant.PaymentStatus}" Foreground="#067647" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="Intake Status" Style="{StaticResource LabelText}" />
                                        <Border Style="{StaticResource Badge}" Background="#FEF0C7" Margin="0,5,0,12">
                                            <TextBlock Text="{Binding ApplicantReview.Applicant.IntakeStatus}" Foreground="#B54708" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="Uploaded Documents" Style="{StaticResource LabelText}" />
                                        <ItemsControl ItemsSource="{Binding ApplicantReview.Applicant.DocumentUrls}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#145DA0" FontSize="14" Margin="0,3,0,3" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ApplicantReview.IdentityConfirmed}"
                                              FontSize="15"
                                              Foreground="#101828">
                                        <TextBlock Text="I verify that the physical applicant matches the biographical data and uploaded documents displayed above."
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                    <Button Content="Continue to Capture"
                                            Command="{Binding ApplicantReview.ContinueCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="190"
                                            HorizontalAlignment="Left"
                                            Margin="0,18,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsFingerprintCaptureVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="370" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                                <StackPanel>
                                    <TextBlock Text="Ten-Print Progress" Style="{StaticResource SectionTitle}" FontSize="20" />
                                    <ListBox ItemsSource="{Binding FingerprintCapture.Fingers}"
                                             SelectedItem="{Binding FingerprintCapture.SelectedFinger}"
                                             BorderBrush="#D9DEE7"
                                             BorderThickness="1"
                                             MinHeight="430">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="54" Height="64" Background="#0B1220" CornerRadius="6" Margin="0,0,8,0">
                                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform" Margin="4" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#101828" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#667085" />
                                                        <TextBlock Text="{Binding MissingReason}" FontSize="12" Foreground="#B54708" />
                                                        <TextBlock Text="{Binding QualityLabel}" FontSize="12" Foreground="#344054" />
                                                        <WrapPanel Margin="0,5,0,0">
                                                            <Button Content="Flat"
                                                                    Command="{Binding DataContext.FingerprintCapture.RetakeFlatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="8,4"
                                                                    MinHeight="26"
                                                                    Margin="0,0,5,0" />
                                                            <Button Content="Roll"
                                                                    Command="{Binding DataContext.FingerprintCapture.RetakeRollCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="8,4"
                                                                    MinHeight="26"
                                                                    Margin="0,0,5,0" />
                                                            <Button Content="Missing"
                                                                    Command="{Binding DataContext.FingerprintCapture.MarkFingerMissingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource DangerButton}"
                                                                    Padding="8,4"
                                                                    MinHeight="26" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding QualityDisplay}" Foreground="#145DA0" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Next Finger"
                                            Command="{Binding FingerprintCapture.NextFingerCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Fingerprint Capture" Style="{StaticResource SectionTitle}" />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FingerprintCapture.ScannerStatusMessage}" Foreground="#344054" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding FingerprintCapture.ShowDeviceList, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button Content="Refresh Devices"
                                                    Command="{Binding FingerprintCapture.RefreshDevicesCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Width="150"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,10" />
                                            <ComboBox ItemsSource="{Binding FingerprintCapture.Devices}"
                                                      SelectedItem="{Binding FingerprintCapture.SelectedDevice}"
                                                      DisplayMemberPath="DisplayName"
                                                      MinHeight="36"
                                                      Margin="0,0,0,10" />
                                            <Button Content="Reconnect Scanner"
                                                    Command="{Binding FingerprintCapture.ConnectSelectedDeviceCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Width="170"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#0B1220" CornerRadius="8" Height="420">
                                            <Image Source="{Binding FingerprintCapture.PreviewImage}" Stretch="Uniform" Margin="16" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                            <TextBlock Text="Selected Finger" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding FingerprintCapture.SelectedFinger.DisplayName}" Style="{StaticResource ValueText}" />

                                            <TextBlock Text="Capture Mode" Style="{StaticResource LabelText}" />
                                            <ComboBox ItemsSource="{Binding FingerprintCapture.CaptureModeOptions}"
                                                      SelectedItem="{Binding FingerprintCapture.SelectedCaptureModeOption}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEnabled="{Binding FingerprintCapture.CanUseCaptureControls}"
                                                      MinHeight="38"
                                                      Margin="0,5,0,16" />

                                            <StackPanel Margin="0,0,0,16" Visibility="{Binding FingerprintCapture.IsSlap442Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="4-4-2 Stage" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="{Binding FingerprintCapture.CurrentSlapGroupDisplay}" Style="{StaticResource ValueText}" />
                                                <Button Content="Retake Entire Right Four"
                                                        Command="{Binding FingerprintCapture.RetakeRightFourCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="0,0,0,8" />
                                                <Button Content="Retake Entire Left Four"
                                                        Command="{Binding FingerprintCapture.RetakeLeftFourCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="0,0,0,8" />
                                                <Button Content="Retake Two Thumbs"
                                                        Command="{Binding FingerprintCapture.RetakeThumbsCommand}"
                                                        Style="{StaticResource SecondaryButton}" />
                                            </StackPanel>

                                            <Button Content="Start Preview"
                                                    Command="{Binding FingerprintCapture.StartPreviewCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,0,10" />
                                            <Button Content="Stop Preview"
                                                    Command="{Binding FingerprintCapture.StopPreviewCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,0,10" />
                                            <Button Content="{Binding FingerprintCapture.CaptureButtonText}"
                                                    Command="{Binding FingerprintCapture.CaptureCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,0,18" />

                                            <TextBlock Text="Missing Reason" Style="{StaticResource LabelText}" />
                                            <ComboBox ItemsSource="{Binding FingerprintCapture.MissingReasons}"
                                                      SelectedItem="{Binding FingerprintCapture.MissingReason}"
                                                      MinHeight="36"
                                                      Margin="0,5,0,10" />
                                            <Button Content="Mark Missing"
                                                    Command="{Binding FingerprintCapture.MarkMissingCommand}"
                                                    Style="{StaticResource DangerButton}"
                                                    Margin="0,0,0,18" />

                                            <TextBlock Text="Quality Score" Style="{StaticResource LabelText}" />
                                            <TextBlock Text="{Binding FingerprintCapture.QualityDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="#145DA0" Margin="0,3,0,10" />
                                            <TextBlock Text="{Binding FingerprintCapture.StatusMessage}" TextWrapping="Wrap" Foreground="#344054" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Margin="0,0,18,0">
                                        <StackPanel>
                                            <TextBlock Text="Capture Guidance" FontSize="18" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,10" />
                                            <TextBlock Text="Clean scanner glass" Foreground="#344054" Margin="0,2" />
                                            <TextBlock Text="Place finger flat" Foreground="#344054" Margin="0,2" />
                                            <TextBlock Text="Use light moisture if finger is dry" Foreground="#344054" Margin="0,2" />
                                            <TextBlock Text="Roll slowly nail-to-nail" Foreground="#344054" Margin="0,2" />
                                            <TextBlock Text="Do not press too hard" Foreground="#344054" Margin="0,2" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="Review Submission"
                                                Command="{Binding GoToSubmissionCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Width="180" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Card}" Visibility="{Binding FingerprintCapture.HasQualityDebugResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Quality Debug" FontSize="18" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Image Source" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FingerprintCapture.LastQualityDebugResult.Source}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="SDK Result" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FingerprintCapture.LastQualityDebugResult.SdkResult}" Style="{StaticResource ValueText}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FingerprintCapture.LastQualityDebugResult.Width}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Height" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding FingerprintCapture.LastQualityDebugResult.Height}" Style="{StaticResource ValueText}" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Byte Length" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FingerprintCapture.LastQualityDebugResult.ByteLength}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Quality Score" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding FingerprintCapture.LastQualityDebugResult.QualityScore}" Style="{StaticResource ValueText}" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Min" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FingerprintCapture.LastQualityDebugResult.MinPixelValue}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Max" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding FingerprintCapture.LastQualityDebugResult.MaxPixelValue}" Style="{StaticResource ValueText}" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Average" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FingerprintCapture.LastQualityDebugResult.AveragePixelValue, StringFormat={}{0:F2}}" Style="{StaticResource ValueText}" />
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Status" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding FingerprintCapture.LastQualityDebugResult.Status}" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <TextBlock Text="{Binding FingerprintCapture.LastQualityDebugResult.Notes}" Foreground="#344054" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Border Background="#FEF3F2" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                                                Visibility="{Binding FingerprintCapture.HasCapturePathWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding FingerprintCapture.CapturePathWarning}" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsSubmissionReviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Submission Review" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SubmissionReview.CapturedCount, StringFormat=Captured fingerprints: {0}}" FontSize="18" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,14" />
                                    <ListView ItemsSource="{Binding SubmissionReview.CapturedFingerprints}" MinHeight="280" BorderBrush="#D9DEE7">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Finger" DisplayMemberBinding="{Binding FingerPosition}" Width="180" />
                                                <GridViewColumn Header="Mode" DisplayMemberBinding="{Binding CaptureMode}" Width="100" />
                                                <GridViewColumn Header="Quality" DisplayMemberBinding="{Binding QualityScore}" Width="100" />
                                                <GridViewColumn Header="Captured At" DisplayMemberBinding="{Binding CapturedAt}" Width="220" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Text="{Binding SubmissionReview.MissingCount, StringFormat=Missing finger records: {0}}" FontSize="18" FontWeight="SemiBold" Foreground="#101828" Margin="0,18,0,14" />
                                    <ListView ItemsSource="{Binding SubmissionReview.MissingFingerprints}" MinHeight="120" BorderBrush="#D9DEE7">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Finger" DisplayMemberBinding="{Binding FingerPosition}" Width="180" />
                                                <GridViewColumn Header="Reason" DisplayMemberBinding="{Binding MissingReason}" Width="180" />
                                                <GridViewColumn Header="Marked At" DisplayMemberBinding="{Binding MarkedMissingAt}" Width="220" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Text="{Binding SubmissionReview.StatusMessage}" Foreground="#344054" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Back to Capture"
                                        Command="{Binding BackToCaptureCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="160"
                                        Margin="0,0,10,0" />
                                <Button Content="Submit Biometrics"
                                        Command="{Binding SubmissionReview.SubmitCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="180" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsCompletionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Completion" Style="{StaticResource SectionTitle}" />
                                <Border Background="#DCFAE6" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                                    <TextBlock Text="Biometrics Compiled Successfully. Record advanced to Forensic Review Queue."
                                               Foreground="#067647"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="Server Reference" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Completion.SubmissionResult.ServerReference}" Style="{StaticResource ValueText}" FontSize="20" />
                                <Button Content="New Intake"
                                        Command="{Binding Completion.NewIntakeCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="150"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1,0,0,0" Padding="22">
            <StackPanel>
                <TextBlock Text="Session Summary" FontSize="20" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,18" />
                <TextBlock Text="Station" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding StationId}" Style="{StaticResource ValueText}" />
                <TextBlock Text="Officer" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding OfficerId}" Style="{StaticResource ValueText}" />
                <TextBlock Text="Tracking Number" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding TrackingNumber}" Style="{StaticResource ValueText}" />
                <TextBlock Text="Applicant" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding ApplicantName}" Style="{StaticResource ValueText}" />
                <TextBlock Text="Captured Prints" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding CapturedCount}" FontSize="34" FontWeight="SemiBold" Foreground="#145DA0" Margin="0,2,0,18" />
                <Button Content="Reset Intake"
                        Command="{Binding NewIntakeCommand}"
                        Style="{StaticResource DangerButton}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
