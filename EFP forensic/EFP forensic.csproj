<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>EFP_forensic</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\x64\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\x64\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\x64\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\x64\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="sdk\**\*.cs" />
    <None Include="sdk\**\*.*" Exclude="sdk\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sdk\bin\x64\RS_SDK.dll" Link="RS_SDK.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sdk\bin\x64\RS_SDK.ini" Link="RS_SDK.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sdk\bin\x64\NFIQ2.dll" Link="NFIQ2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sdk\bin\x64\opencv_world4100.dll" Link="opencv_world4100.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sdk\bin\x64\tensorflowlite_c.dll" Link="tensorflowlite_c.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
